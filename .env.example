# ── Database ────────────────────────────────────────────────
POSTGRES_PASSWORD=windmotion_dev
NEO4J_PASSWORD=windmotion_dev

# ── Connection URLs (for app code) ─────────────────────────
DATABASE_URL=postgresql://windmotion:windmotion_dev@localhost:5432/windmotion
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
REDIS_URL=redis://localhost:6379/0

# ── LLM (OpenRouter - unified API for all models) ──────────
OPENROUTER_API_KEY=your_openrouter_api_key
# Optional: custom base URL (default: https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Blockchain Data ────────────────────────────────────────
BSCSCAN_API_KEY=your_bscscan_api_key

# ── Worker ─────────────────────────────────────────────────
WORKER_CONCURRENCY=3
TASK_TIMEOUT=600

# ── CORS ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://frontend-production-196a6.up.railway.app

# ── Optional ───────────────────────────────────────────────
DEEPL_API_KEY=your_deepl_api_key
FRONTEND_URL=http://localhost:3000
