{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "node": "20",
    "python": "3.11"
  },
  "buildAptPackages": ["nginx", "gettext-base"],
  "steps": {
    "install": {
      "inputs": [{"local": true, "include": ["frontend/package.json", "frontend/package-lock.json"]}],
      "commands": ["cd frontend && npm ci"]
    },
    "build": {
      "inputs": [
        {"step": "install"},
        {"local": true, "include": ["frontend/"]}
      ],
      "commands": ["cd frontend && npm run build"]
    }
  },
  "deploy": {
    "startCommand": "envsubst '${BACKEND_URL}' < frontend/nginx.conf.template > /etc/nginx/conf.d/default.conf && cp -r frontend/dist/. /usr/share/nginx/html/ && nginx -g 'daemon off;'",
    "inputs": [
      {"step": "build"},
      {"local": true, "include": ["frontend/nginx.conf.template", "frontend/dist/"]}
    ]
  }
}
