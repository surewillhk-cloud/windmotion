{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "python": "3.11"
  },
  "buildAptPackages": ["gcc", "libpq-dev"],
  "steps": {
    "install": {
      "inputs": [{"local": true, "include": ["backend/requirements.txt", "worker/requirements.txt"]}],
      "commands": [
        "pip install -r backend/requirements.txt",
        "pip install -r worker/requirements.txt"
      ]
    }
  },
  "deploy": {
    "startCommand": "python -m worker.main",
    "inputs": [
      {"step": "install"},
      {"local": true, "include": ["backend/", "worker/"]}
    ]
  }
}
