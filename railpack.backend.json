{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "python": "3.11"
  },
  "buildAptPackages": ["gcc", "libpq-dev"],
  "steps": {
    "install": {
      "inputs": [{"local": true, "include": ["backend/requirements.txt"]}],
      "commands": ["pip install -r backend/requirements.txt"]
    }
  },
  "deploy": {
    "startCommand": "python -m backend.db.migrations.run_migrations 2>&1 || echo 'Migration skipped'; exec uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8080}",
    "inputs": [
      {"step": "install"},
      {"local": true, "include": ["backend/", "worker/"]}
    ]
  }
}
